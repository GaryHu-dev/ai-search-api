# Copy to `.env` for local development: cp .env.example .env
# The app validates these at startup and refuses to boot if anything is invalid.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Matches the credentials in docker-compose.yml.
# In production behind multiple replicas, point this at a connection pooler and
# set ?pgbouncer=true&connection_limit=N — see docs/deployment.md.
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public

# Auth. Generate a real secret for anything but local dev, e.g.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Per-account lockout after repeated failed logins.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Express trust proxy — set to match your topology in production (behind
# Cloudflare/a load balancer), e.g. TRUST_PROXY=1 for a single proxy hop.
# Leave unset locally (no proxy).
# TRUST_PROXY=1

# Optional: backend-driven Google sign-in (authorization-code / redirect flow).
# Enabled only when all three of CLIENT_ID, CLIENT_SECRET, and CALLBACK_URL are
# set (create the OAuth client + secret in the Google Cloud console). Leave unset
# to keep Google sign-in off — the app boots fine and the routes stay dormant.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Where Google redirects the browser back to (must match the Authorised redirect
# URI in the Google Cloud console).
# GOOGLE_CALLBACK_URL=http://localhost:3000/v1/auth/google/callback
# Frontend URL we 302 the browser to after login, with the tokens (or an error)
# in the URL fragment (#accessToken=...&refreshToken=...&tokenType=Bearer&expiresIn=...).
# GOOGLE_POST_LOGIN_REDIRECT=http://localhost:5173/auth/callback

# GEO audit SSRF-guard override. 'true' lets the audit fetcher reach private /
# loopback URLs. Dev and tests ONLY — never set in production (the app refuses to
# boot if this is 'true' while NODE_ENV=production).
# GEO_ALLOW_PRIVATE_URLS=true

# Object storage (S3-compatible). Values below target the local MinIO in
# docker-compose. In production, point these at a Cloudflare R2 bucket:
#   STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   STORAGE_REGION=auto
#   STORAGE_FORCE_PATH_STYLE=false
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=app-files
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
